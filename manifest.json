{
  "manifest_version": 3,
  "name": "تصحیح خودکار فارسی",
  "description": "جایگزینی خودکار واژه‌ها در کادرهای نوشتن فایرفاکس",
  "version": "0.3.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "autocorrect-fa@afshin-ir.github.io",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; font-src 'self';"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "تصحیح خودکار"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
